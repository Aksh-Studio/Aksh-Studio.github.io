rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // GLOBAL HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == "akshat124.am12@gmail.com";
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =========================================================
    // USER HELPERS
    // =========================================================

    function validUserCreate(userId) {
      return signedIn()
        && request.auth.uid == userId

        // Prevent arbitrary field injection.
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "firstName",
          "middleName",
          "lastName",
          "fullName",
          "name",
          "dob",
          "gender",
          "phone",
          "photoURL",
          "customProfilePic",
          "nickname",
          "wallpaper",
          "displayName",
          "tokens",
          "blockedUsers",
          "pendingBindingTime",
          "createdAt",
          "lastLogin"
        ])

        // UID, when stored, must match Auth UID.
        && (
          !request.resource.data.keys().hasAny(["uid"])
          || request.resource.data.uid == userId
        )

        // Email, when stored, must match Firebase Auth.
        && (
          !request.resource.data.keys().hasAny(["email"])
          || request.resource.data.email == request.auth.token.email
        )

        // New users cannot grant themselves tokens.
        && (
          !request.resource.data.keys().hasAny(["tokens"])
          || request.resource.data.tokens == 0
        )

        && (
          !request.resource.data.keys().hasAny(["blockedUsers"])
          || request.resource.data.blockedUsers is list
        )

        && (
          !request.resource.data.keys().hasAny(["createdAt"])
          || request.resource.data.createdAt is timestamp
        );
    }

    function validUserSelfUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return isSelf(userId)

        // Only fields used by the existing applications.
        && changed.hasOnly([
          "uid",
          "email",
          "firstName",
          "middleName",
          "lastName",
          "fullName",
          "name",
          "dob",
          "gender",
          "phone",
          "photoURL",
          "customProfilePic",
          "nickname",
          "wallpaper",
          "displayName",
          "tokens",
          "blockedUsers",
          "pendingBindingTime",
          "lastLogin"
        ])

        // UID cannot be changed.
        && (
          !changed.hasAny(["uid"])
          || request.resource.data.uid == userId
        )

        // Email cannot be forged.
        && (
          !changed.hasAny(["email"])
          || request.resource.data.email == request.auth.token.email
        )

        // Token changes are restricted to exactly +1.
        && (
          !changed.hasAny(["tokens"])
          ||
          (
            request.resource.data.tokens is number
            &&
            (
              (
                resource.data.keys().hasAny(["tokens"])
                && resource.data.tokens is number
                && request.resource.data.tokens == resource.data.tokens + 1
              )
              ||
              (
                !resource.data.keys().hasAny(["tokens"])
                && request.resource.data.tokens == 1
              )
            )
          )
        )

        && (
          !changed.hasAny(["blockedUsers"])
          || request.resource.data.blockedUsers is list
        )

        // pendingBindingTime can be added/updated or removed.
        && (
          !changed.hasAny(["pendingBindingTime"])
          ||
          !request.resource.data.keys().hasAny(["pendingBindingTime"])
          ||
          request.resource.data.pendingBindingTime is number
        )

        && (
          !changed.hasAny(["lastLogin"])
          || request.resource.data.lastLogin is number
        );
    }

    // =========================================================
    // CHAT HELPERS
    // =========================================================

    function chatExists(chatId) {
      return exists(
        /databases/$(database)/documents/chats/$(chatId)
      );
    }

    function chatData(chatId) {
      return get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data;
    }

    function isChatMember(chatId) {
      return signedIn()
        && chatExists(chatId)
        && chatData(chatId).participants is list
        && request.auth.uid in chatData(chatId).participants;
    }

    function isChatAdmin(chatId) {
      return signedIn()
        && chatExists(chatId)
        && chatData(chatId).admins is list
        && request.auth.uid in chatData(chatId).admins;
    }

    function isSystemChat(chatId) {
      return chatId == "global_channel"
        || chatId == "aksh_help";
    }

    function isDm(chatId) {
      return chatExists(chatId)
        && chatData(chatId).type == "dm";
    }

    function isGroup(chatId) {
      return chatExists(chatId)
        && chatData(chatId).type == "group";
    }

    // =========================================================
    // READ-RECEIPT SECURITY
    // =========================================================

    function changedOnlyOwnReadReceipt() {
      return request.resource.data.keys().hasAny(["readReceipts"])
        && request.resource.data.readReceipts is map
        && (
          (
            !resource.data.keys().hasAny(["readReceipts"])
            && request.resource.data.readReceipts.keys().hasOnly([
              request.auth.uid
            ])
          )
          ||
          (
            resource.data.keys().hasAny(["readReceipts"])
            && resource.data.readReceipts is map
            && request.resource.data.readReceipts
                 .diff(resource.data.readReceipts)
                 .affectedKeys()
                 .hasOnly([request.auth.uid])
          )
        );
    }

    // =========================================================
    // MEMBER SELF-SERVICE CHAT UPDATE
    // =========================================================

    function isMemberSelfServiceUpdate(chatId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      let hasOwnDeleted =
        changed.hasAny([
          "deletedFor_" + request.auth.uid
        ]);

      let hasOwnCleared =
        changed.hasAny([
          "clearedAt_" + request.auth.uid
        ]);

      let hasOtherDeleted = false;

      // DM recipient visibility flag.
      if (chatData(chatId).type == "dm"
          && chatData(chatId).participants is list
          && chatData(chatId).participants.size() == 2) {

        let otherUid =
          chatData(chatId).participants[0] == request.auth.uid
            ? chatData(chatId).participants[1]
            : chatData(chatId).participants[0];

        hasOtherDeleted =
          changed.hasAny([
            "deletedFor_" + otherUid
          ]);
      }

      return isChatMember(chatId)

        && (
          chatData(chatId).type == "dm"
          || chatData(chatId).type == "group"
        )

        // Members may update only their own state plus
        // legitimate message/sidebar metadata.
        && changed.hasOnly([
          "lastMessageTime",
          "lastMessageSenderId",
          "readReceipts",
          "deletedFor_" + request.auth.uid,
          "clearedAt_" + request.auth.uid,
          "deletedFor_" +
            (
              chatData(chatId).type == "dm"
              && chatData(chatId).participants[0] == request.auth.uid
                ? chatData(chatId).participants[1]
                : chatData(chatId).participants[0]
            )
        ])

        // If message metadata changes, both fields must be coherent.
        && (
          !changed.hasAny([
            "lastMessageTime",
            "lastMessageSenderId"
          ])
          ||
          (
            changed.hasAll([
              "lastMessageTime",
              "lastMessageSenderId"
            ])
            && request.resource.data.lastMessageSenderId
                 == request.auth.uid
            && request.resource.data.lastMessageTime is number
          )
        )

        // Own Delete for Me flag.
        && (
          !hasOwnDeleted
          || request.resource.data[
               "deletedFor_" + request.auth.uid
             ] is bool
        )

        // Own Clear Chat timestamp.
        && (
          !hasOwnCleared
          || request.resource.data[
               "clearedAt_" + request.auth.uid
             ] is number
        )

        // Only the authenticated user's receipt entry may change.
        && (
          !changed.hasAny(["readReceipts"])
          || changedOnlyOwnReadReceipt()
        )

        // A DM sender may reveal the other participant's
        // chat only while writing legitimate message metadata.
        && (
          !hasOtherDeleted
          ||
          (
            chatData(chatId).type == "dm"

            && request.resource.data[
                 "deletedFor_" +
                 (
                   chatData(chatId).participants[0] == request.auth.uid
                     ? chatData(chatId).participants[1]
                     : chatData(chatId).participants[0]
                 )
               ] == false

            && changed.hasAll([
              "lastMessageTime",
              "lastMessageSenderId"
            ])

            && request.resource.data.lastMessageSenderId
                 == request.auth.uid
          )
        );
    }

    // =========================================================
    // GROUP STRUCTURAL ADMIN UPDATE
    // =========================================================

    function isGroupAdminStructuralUpdate(chatId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return isChatAdmin(chatId)
        && chatData(chatId).type == "group"

        && changed.hasOnly([
          "name",
          "icon",
          "participants",
          "admins"
        ])

        && request.resource.data.type == resource.data.type
        && request.resource.data.createdBy == resource.data.createdBy

        && request.resource.data.participants is list
        && request.resource.data.admins is list

        // Admins must remain participants.
        && request.resource.data.participants.hasAll(
             request.resource.data.admins
           )

        // Creator must remain a member.
        && request.resource.data.participants.hasAny([
             resource.data.createdBy
           ]);
    }

    // =========================================================
    // GROUP SELF-LEAVE
    // =========================================================

    function isValidSelfGroupLeave(chatId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return isChatMember(chatId)
        && chatData(chatId).type == "group"

        && changed.hasOnly([
          "participants",
          "admins"
        ])

        // Nobody except the current user may disappear.
        && resource.data.participants.hasAll(
             request.resource.data.participants
           )

        && !request.resource.data.participants.hasAny([
             request.auth.uid
           ])

        // Exactly one participant is removed.
        && request.resource.data.participants.size()
             == resource.data.participants.size() - 1

        && (
          // Non-admin leaves.
          request.resource.data.admins == resource.data.admins

          ||

          // Admin leaves themselves.
          (
            resource.data.admins.hasAll(
              request.resource.data.admins
            )
            && !request.resource.data.admins.hasAny([
                 request.auth.uid
               ])
            && request.resource.data.admins.size()
                 == resource.data.admins.size() - 1
          )
        );
    }

    // =========================================================
    // SYSTEM CHAT METADATA
    // =========================================================

    function isValidSystemChatMetadataUpdate(chatId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return signedIn()
        && isSystemChat(chatId)

        && changed.hasOnly([
          "lastMessageTime",
          "lastMessageSenderId"
        ])

        && request.resource.data.lastMessageSenderId
             == request.auth.uid

        && request.resource.data.lastMessageTime is number;
    }

    // =========================================================
    // HELP / REPORTS
    // =========================================================

    match /help_complaints/{document} {

      // Reports and Help requests are authenticated user actions.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "subject",
          "details",
          "date",
          "status"
        ])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.subject is string
        && request.resource.data.details is string
        && request.resource.data.date is number
        && request.resource.data.status == "Unresolved";

      // Owner-only complaint management.
      allow read, update, delete: if isOwner();
    }

    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // Required by:
      // - Network Directory
      // - Leaderboard
      // - profile lookup
      // - calendar/office/profile pages
      //
      // Authentication is required.
      allow read: if signedIn();

      allow create: if validUserCreate(userId);

      allow update: if isOwner()
        || validUserSelfUpdate(userId);

      allow delete: if isOwner();

      // =======================================================
      // CALENDAR
      // =======================================================

      match /calendarEvents/{eventId} {

        allow read, create, update, delete:
          if isSelf(userId);
      }

      // =======================================================
      // CALCULATOR HISTORY
      // =======================================================
      //
      // The current calculator primarily uses localStorage,
      // but keep this path private in case it is used again.

      match /calculatorHistory/{historyId} {

        allow read, create, delete:
          if isSelf(userId);

        allow update: if false;
      }
    }

    // =========================================================
    // CHATS
    // =========================================================

    match /chats/{chatId} {

      // A user can read:
      // - their own chats
      // - Global Channel
      // - Help Centre
      // - Owner can read everything
      allow read: if isOwner()
        || isSystemChat(chatId)
        || isChatMember(chatId);

      // -------------------------------------------------------
      // CREATE CHAT
      // -------------------------------------------------------

      allow create: if signedIn()
        && (
          // Owner may create system/group/DM documents.
          isOwner()

          ||

          // Normal DM creation:
          // authenticated creator must be one of exactly 2 members.
          (
            request.resource.data.type == "dm"
            && request.resource.data.participants is list
            && request.resource.data.participants.size() == 2
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants[0]
                 != request.resource.data.participants[1]
          )

          ||

          // Normal group creation:
          // creator must be the initial member + admin.
          (
            request.resource.data.type == "group"
            && request.resource.data.participants is list
            && request.resource.data.admins is list
            && request.resource.data.createdBy
                 == request.auth.uid
            && request.auth.uid
                 in request.resource.data.participants
            && request.auth.uid
                 in request.resource.data.admins
            && request.resource.data.participants.size() >= 1
            && request.resource.data.admins.hasAll(
                 [request.auth.uid]
               )
          )
        );

      // -------------------------------------------------------
      // UPDATE CHAT
      // -------------------------------------------------------

      allow update: if isOwner()

        // Group management.
        || isGroupAdminStructuralUpdate(chatId)

        // Member read receipt / Clear / Delete for Me /
        // message sidebar metadata.
        || isMemberSelfServiceUpdate(chatId)

        // Member leaving their own group.
        || isValidSelfGroupLeave(chatId)

        // Global Channel / Help Centre message metadata.
        || isValidSystemChatMetadataUpdate(chatId);

      // -------------------------------------------------------
      // DELETE CHAT
      // -------------------------------------------------------

      // Delete-for-everyone:
      // Owner may delete anything.
      // Group Admin may delete their group.
      // Normal DM users do NOT get arbitrary whole-room deletion.
      allow delete: if isOwner()
        || (
          isGroup(chatId)
          && isChatAdmin(chatId)
        );

      // =======================================================
      // CHAT MESSAGES
      // =======================================================

      match /messages/{messageId} {

        // -----------------------------
        // READ
        // -----------------------------

        allow read: if signedIn()
          && (
            isOwner()
            || isSystemChat(chatId)
            || isChatMember(chatId)
          );

        // -----------------------------
        // CREATE
        // -----------------------------

        allow create: if signedIn()

          && (
            isOwner()
            || isSystemChat(chatId)
            || isChatMember(chatId)
          )

          // Sender identity cannot be forged.
          && request.resource.data.senderId
               == request.auth.uid

          // Owner badge cannot be forged.
          && (
            request.resource.data.isOwner == false
            || isOwner()
          );

        // -----------------------------
        // UPDATE
        // -----------------------------

        allow update: if signedIn()
          && (
            isOwner()
            || isChatAdmin(chatId)
            || (
              isChatMember(chatId)
              && resource.data.senderId
                   == request.auth.uid
            )
          )

          // Sender cannot be changed.
          && request.resource.data.senderId
               == resource.data.senderId;

        // -----------------------------
        // DELETE
        // -----------------------------

        allow delete: if signedIn()
          && (
            isOwner()
            || isChatAdmin(chatId)
            || (
              isChatMember(chatId)
              && resource.data.senderId
                   == request.auth.uid
            )
          );
      }
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
